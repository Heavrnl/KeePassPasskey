<UserControl xmlns:u="using:KeePassPasskeyProvider.Util"
xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
						 xmlns:fa="using:FluentAvalonia.UI.Controls"
						 x:Class="KeePassPasskeyProvider.App.Controls.SetupGuide"
						 x:DataType="vm:SetupGuideViewModel">
		<Expander IsExpanded="{Binding IsSetupExpanded, Mode=TwoWay}">
				<Expander.Header>
						<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<TextBlock Text="{u:Tr GettingStarted}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
								<Button Classes="hyperlink" Padding="4" Opacity="0.6"
												Command="{Binding OpenUserGuideCommand}"
												ToolTip.Tip="{u:Tr OpenUserGuide}"
												VerticalAlignment="Center">
										<fa:FAFontIcon Glyph="&#xE8F1;" FontSize="16" FontFamily="Segoe Fluent Icons" />
								</Button>
						</StackPanel>
				</Expander.Header>

				<StackPanel Margin="4 4 4 8">
						<!-- Step 1 -->
						<Grid ColumnDefinitions="28,*" ColumnSpacing="12" Margin="0 10 0 10">
								<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
												Background="{DynamicResource ControlFillColorSecondaryBrush}"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 1 0 0">
										<TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
															 HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<StackPanel Grid.Column="1" Spacing="4">
										<TextBlock Text="{u:Tr Step1Title}" FontWeight="SemiBold" FontSize="13" />
										<TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
												<Run Text="{u:Tr Step1Desc}" />
										</TextBlock>
										<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
												<Button Content="{u:Tr InstallPlugin}"
																Command="{Binding InstallPluginCommand}"
																IsVisible="{Binding HasBundledPlugin}"
																ToolTip.Tip="{u:Tr InstallPluginTooltip}"
																Padding="6 2" FontSize="12" />
												<Button Content="{u:Tr ShowPluginFile}"
																Command="{Binding ShowPluginFileCommand}"
																IsVisible="{Binding HasBundledPlugin}"
																ToolTip.Tip="{u:Tr ShowPluginFileTooltip}"
																Padding="6 2" FontSize="12" />
										</StackPanel>
								</StackPanel>
						</Grid>

						<Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.5" />

						<!-- Step 2 -->
						<Grid ColumnDefinitions="28,*" ColumnSpacing="12" Margin="0 10 0 10">
								<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
												Background="{DynamicResource ControlFillColorSecondaryBrush}"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 1 0 0">
										<TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
															 HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<StackPanel Grid.Column="1" Spacing="4">
										<TextBlock Text="{u:Tr Step2Title}" FontWeight="SemiBold" FontSize="13" />
										<TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
												<Run Text="{u:Tr Step2Desc}" />
										</TextBlock>
										<Button Content="{u:Tr AdvancedPasskeyOptions}"
														Command="{Binding OpenPasskeySettingsCommand}"
														ToolTip.Tip="Open advanced passkey options in Windows Settings"
														Padding="6 2" FontSize="12" HorizontalAlignment="Left" />
								</StackPanel>
						</Grid>

						<Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.5" />

						<!-- Step 3 -->
						<Grid ColumnDefinitions="28,*" ColumnSpacing="12" Margin="0 10 0 10">
								<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
												Background="{DynamicResource ControlFillColorSecondaryBrush}"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 1 0 0">
										<TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
															 HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="{u:Tr Step3Title}" FontWeight="SemiBold" FontSize="13" />
										<TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
												<Run Text="{u:Tr Step3Desc}" />
										</TextBlock>
								</StackPanel>
						</Grid>

						<Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.5" />

						<!-- Step 4 -->
						<Grid ColumnDefinitions="28,*" ColumnSpacing="12" Margin="0 10 0 4">
								<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
												Background="{DynamicResource ControlFillColorSecondaryBrush}"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 1 0 0">
										<TextBlock Text="4" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
															 HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="{u:Tr Step4Title}" FontWeight="SemiBold" FontSize="13" />
										<TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
												<Run Text="{u:Tr Step4Desc}" />
										</TextBlock>
								</StackPanel>
						</Grid>
				</StackPanel>
		</Expander>
</UserControl>
