<UserControl xmlns:u="using:KeePassPasskeyProvider.Util" 
xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
			 xmlns:utils="using:KeePassPasskeyProvider.App.Utils"
						 xmlns:conv="using:KeePassPasskeyProvider.App.Converters"
						 x:Class="KeePassPasskeyProvider.App.Pages.SettingsPage"
						 x:DataType="vm:SettingsViewModel"
						 x:CompileBindings="True">

		<Grid RowDefinitions="Auto,*">
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="16 16 16 4">
						<TextBlock Text="{u:Tr SettingsTitle}"
											 Theme="{StaticResource TitleTextBlockStyle}" />
						<ui:FASymbolIcon Grid.Column="1" Symbol="ImportantFilled" FontSize="16"
													 VerticalAlignment="Center" Margin="0 0 8 0"
													 IsVisible="{Binding HasUnsavedChanges}"
													 Foreground="{DynamicResource SystemFillColorCautionBrush}"
													 ToolTip.Tip="{u:Tr UnsavedChangesTooltip}" />
						<Button Grid.Column="2"
										Command="{Binding ResetCommand}"
										IsEnabled="{Binding !IsSaving}"
										IsVisible="{Binding HasUnsavedChanges}"
										ToolTip.Tip="{u:Tr DiscardChangesTooltip}"
										VerticalAlignment="Center"
										Margin="0 0 4 0">
								<ui:FASymbolIcon Symbol="Undo" FontSize="18" />
						</Button>
			<Button Grid.Column="3"
										Command="{Binding ResetToDefaultsCommand}"
										IsEnabled="{Binding !IsSaving}"
										IsVisible="{Binding CanResetToDefaults}"
										ToolTip.Tip="{u:Tr ResetDefaultsTooltip}"
										VerticalAlignment="Center"
										Margin="0 0 4 0">
								<ui:FAFontIcon Glyph="&#xE75C;" FontSize="18" FontFamily="Segoe Fluent Icons" />
			</Button>
						<Button Grid.Column="4"
										Command="{Binding SaveCommand}"
										IsEnabled="{Binding CanSave}"
										ToolTip.Tip="{u:Tr SaveSettingsTooltip}"
										VerticalAlignment="Center"
										Classes="accent">
								<ui:FASymbolIcon Symbol="Save" FontSize="18" />
						</Button>
				</Grid>
				<ScrollViewer Grid.Row="1">
				<StackPanel Spacing="8" Margin="16 8 16 16">

						<Border IsVisible="{Binding LoadFailed}"
										Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
										CornerRadius="4" Padding="12 8">
								<StackPanel Orientation="Horizontal" Spacing="8">
										<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																		 Foreground="{DynamicResource SystemFillColorCautionBrush}"
																		 VerticalAlignment="Center" />
										<TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
															 Text="{u:Tr LoadSettingsFailed}" />
								</StackPanel>
						</Border>

						<ui:FASettingsExpander Header="{u:Tr HeaderAppearance}"
																 IconSource="DarkTheme"
																 Description="{u:Tr DescAppearance}"
																 IsExpanded="True">
								<ui:FASettingsExpander.Footer>
										<ComboBox SelectedItem="{Binding Theme}"
															ItemsSource="{Binding Themes}"
															MinWidth="120" />
								</ui:FASettingsExpander.Footer>

								
								<ui:FASettingsExpanderItem Content="{u:Tr Language}"
																				 Description="{u:Tr DescAppearance}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding SelectedLanguage}"
																	ItemsSource="{Binding Languages}"
																	MinWidth="120" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr SystemTrayIcon}"
																				 Description="{u:Tr SystemTrayIconDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding EnableTrayIcon}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{u:Tr HeaderVerification}"
																 IconSource="OtherUser"
																 Description="{u:Tr DescVerification}"
																 IsExpanded="True">

								<ui:FASettingsExpanderItem Content="{u:Tr ErrorNotifications}"
																				 Description="{u:Tr ErrorNotificationsDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding ShowErrorNotifications}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr ApprovalTimeout}"
																				 Description="{u:Tr ApprovalTimeoutDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ui:FANumberBox Value="{Binding NotificationTimeoutSeconds}"
																			Minimum="5"
																			Maximum="300"
																			SmallChange="5"
																			ValidationMode="InvalidInputOverwritten"
																			SpinButtonPlacementMode="Inline"
																			MinWidth="120"
									  NumberFormatter="{x:Static utils:NumberFormatters.Seconds}" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem>
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="0" Margin="0 4">
														<StackPanel Spacing="2" Margin="0 0 0 6">
																<StackPanel Orientation="Horizontal" Spacing="8">
																		<TextBlock Text="{u:Tr RegistrationVerification}" VerticalAlignment="Center" />
																		<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																				VerticalAlignment="Center"
																				IsVisible="{Binding IsRegistrationSilent}"
																				Foreground="{DynamicResource SystemFillColorCautionBrush}"
																				ToolTip.Tip="{x:Static vm:SettingsViewModel.SilentVerificationWarning}" />
																</StackPanel>
																<TextBlock Text="{u:Tr RegistrationVerificationDesc}"
																		Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																		FontSize="12" />
														</StackPanel>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{u:Tr WindowsHelloToggle}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding RegistrationWindowsHello}" MinHeight="0"
																		OnContent="On"
																		OffContent="Off" />
														</Grid>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{u:Tr PromptToggle}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding RegistrationPrompt}" MinHeight="0"
																		OnContent="On"
																		OffContent="Off" />
														</Grid>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem>
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="0" Margin="0 4">
														<StackPanel Spacing="2" Margin="0 0 0 6">
																<StackPanel Orientation="Horizontal" Spacing="8">
																		<TextBlock Text="{u:Tr SignInVerification}" VerticalAlignment="Center" />
																		<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																				VerticalAlignment="Center"
																				IsVisible="{Binding IsSignInSilent}"
																				Foreground="{DynamicResource SystemFillColorCautionBrush}"
																				ToolTip.Tip="{x:Static vm:SettingsViewModel.SilentVerificationWarning}" />
																</StackPanel>
																<TextBlock Text="{u:Tr SignInVerificationDesc}"
																		Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																		FontSize="12" />
														</StackPanel>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{u:Tr WindowsHelloToggle}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding SignInWindowsHello}" MinHeight="0"
																		OnContent="On"
																		OffContent="Off" />
														</Grid>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{u:Tr PromptToggle}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding SignInPrompt}" MinHeight="0"
																		OnContent="On"
																		OffContent="Off" />
														</Grid>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr SkipHelloAfterUnlock}"
																				 Description="{u:Tr SkipHelloAfterUnlockDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SkipWindowsHelloAfterUnlock}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{u:Tr HeaderPasskeyEntries}"
																 IconSource="Save"
																 Description="{u:Tr DescPasskeyEntries}"
																 IsExpanded="True">

								<ui:FASettingsExpanderItem Content="{u:Tr SaveNewPasskeysIn}"
																				 Description="{u:Tr SaveNewPasskeysInDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding NewEntryGroupMode}"
																	ItemsSource="{Binding GroupModes}"
																	MinWidth="160">
														<ComboBox.ItemTemplate>
																<DataTemplate>
																		<TextBlock Text="{Binding Converter={x:Static conv:PasskeyEntryGroupModeConverters.Text}}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr EntryTitle}"
																				 Description="{u:Tr EntryTitleDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<TextBox Text="{Binding EntryTitleTemplate}"
																 PlaceholderText="{}{RP_NAME} (Passkey)"
																 Width="240" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr StoreResolvedPlaceholders}"
																				 Description="{u:Tr StoreResolvedPlaceholdersDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding ResolveTitlePlaceholders}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr TagNewPasskeys}"
																				 Description="{u:Tr TagNewPasskeysDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding AddPasskeyTag}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr AllowDuplicatePasskeys}"
																				 Description="{u:Tr AllowDuplicatePasskeysDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding ExcludeCredentialCheckMode}"
																	ItemsSource="{Binding ExcludeCredentialCheckModes}"
																	MinWidth="200">
														<ComboBox.ItemTemplate>
																<DataTemplate>
																		<TextBlock Text="{Binding Converter={x:Static conv:ExcludeCredentialCheckModeConverters.Text}}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{u:Tr HeaderAdvanced}"
																 IconSource="Setting"
																 Description="{u:Tr DescAdvanced}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem Content="{u:Tr LogLevel}"
																				 Description="{u:Tr LogLevelDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding LogLevel}"
																	ItemsSource="{Binding LogLevels}"
																	MinWidth="120" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr StatusRefreshInterval}"
																				 Description="{u:Tr StatusRefreshIntervalDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ui:FANumberBox Value="{Binding StatusRefreshIntervalSeconds}"
																			Minimum="1"
																			Maximum="3600"
																			SmallChange="5"
																			ValidationMode="InvalidInputOverwritten"
																			SpinButtonPlacementMode="Inline"
																			MinWidth="120"
									  NumberFormatter="{x:Static utils:NumberFormatters.Seconds}" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr OfferSavingToExistingEntry}"
																				 Description="{u:Tr OfferSavingToExistingEntryDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SaveToExistingEntry}"
																			IsEnabled="{Binding IsSaveToExistingEntryAvailable}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr CheckForPluginUpdates}"
																			 Description="{u:Tr CheckForPluginUpdatesDesc}">
									<ui:FASettingsExpanderItem.Footer>
											<ToggleSwitch IsChecked="{Binding CheckForPluginUpdates}"
																OnContent="On"
																OffContent="Off"
																Margin="0 0 4 0" />
									</ui:FASettingsExpanderItem.Footer>
							</ui:FASettingsExpanderItem>

							<ui:FASettingsExpanderItem Content="{u:Tr UseLegacyNotificationPrompts}"
																				 Description="{u:Tr UseLegacyNotificationPromptsDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding UseLegacyNotificationPrompts}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{u:Tr HeaderExpert}"
																 IconSource="Important"
																 Description="{u:Tr DescExpert}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem Content="{u:Tr WindowsCredentialCache}"
																				 Description="{u:Tr WindowsCredentialCacheDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SyncCredentialsToWindows}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr BackupEligibility}"
																				 Description="{u:Tr BackupEligibilityDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding NewPasskeyBackupEligible}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr BackupState}"
																				 Description="{u:Tr BackupStateDesc}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding NewPasskeyBackupState}"
																			IsEnabled="{Binding NewPasskeyBackupEligible}"
																			OnContent="On"
																			OffContent="Off"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem>
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="8" Margin="0 4">
														<StackPanel Spacing="2">
																<TextBlock Text="{u:Tr SpoofAaguid}" />
																<TextBlock Text="{u:Tr SpoofAaguidDesc}"
																					 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																					 FontSize="12"
																					 TextWrapping="Wrap" />
														</StackPanel>
														<StackPanel Orientation="Horizontal" Spacing="6">
																<TextBox Text="{Binding SpoofAaguid}"
																				 PlaceholderText="{Binding DefaultAaguidText}"
																				 IsEnabled="{Binding !IsApplyingAaguid}"
																				 Width="330"
																				 FontFamily="Cascadia Mono, Consolas, monospace"
																				 VerticalAlignment="Center" />
																<Button Command="{Binding ClearAaguidCommand}"
																				IsEnabled="{Binding !IsApplyingAaguid}"
																				ToolTip.Tip="{u:Tr ClearField}"
																				VerticalAlignment="Center">
																		<ui:FAFontIcon Glyph="&#xE75C;" FontSize="16" FontFamily="Segoe Fluent Icons" />
																</Button>
																<Button Content="{u:Tr Apply}"
																				Command="{Binding ApplyAaguidCommand}"
																				Classes="accent"
																				VerticalAlignment="Center" />
														</StackPanel>
														<TextBlock Text="{Binding SpoofAaguidError}"
																			 IsVisible="{Binding !IsSpoofAaguidValid}"
																			 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
																			 TextWrapping="Wrap"
																			 FontSize="12" />
														<TextBlock Text="{Binding SpoofAaguidStatus}"
																			 IsVisible="{Binding SpoofAaguidStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
																			 Foreground="{DynamicResource SystemFillColorSuccessBrush}"
																			 TextWrapping="Wrap"
																			 FontSize="12" />
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{u:Tr HeaderAbout}"
																 IconSource="Help"
																 Description="{u:Tr DescAbout}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem Content="{u:Tr Copyright}"
																				 Description="&#169; 2026 Uwe K&#246;gel and contributors" />

								<ui:FASettingsExpanderItem>
										<ui:FASettingsExpanderItem.Content>
												<StackPanel>
														<TextBlock Text="{u:Tr Version}" />
														<StackPanel Orientation="Horizontal" Spacing="6" Margin="0 1 0 0">
																<TextBlock Text="{Binding AppVersion}"
																					 FontSize="12"
																					 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																					 VerticalAlignment="Center" />
																<Button x:Name="VerifyReleaseButton"
																				Command="{Binding VerifyReleaseCommand}"
																				VerticalAlignment="Center"
																				Padding="0"
																				Background="Transparent"
																				BorderBrush="Transparent"
																				BorderThickness="0"
																				ToolTip.Tip="{Binding VerifyReleaseMessage}"
																				ToolTip.ShowDelay="0">
																		<Button.Styles>
																				<Style Selector="Button:pointerover /template/ ContentPresenter">
																						<Setter Property="Background" Value="Transparent" />
																				</Style>
																				<Style Selector="Button:pressed /template/ ContentPresenter">
																						<Setter Property="Background" Value="Transparent" />
																				</Style>
																		</Button.Styles>
																		<Path Data="{x:Static utils:ChannelIcon.Geometry}"
																					Fill="{DynamicResource TextFillColorSecondaryBrush}"
																					Stretch="Uniform" Width="11" Height="11" />
																</Button>
														</StackPanel>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding CopyToClipboardCommand}"
																CommandParameter="{Binding AppVersionFull}"
																ToolTip.Tip="Copy version">
														<ui:FASymbolIcon Symbol="Copy" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr Website}"
																				 Description="keepasspasskey.github.io">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://keepasspasskey.github.io"
																ToolTip.Tip="Open website">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr SourceCode}"
																				 Description="github.com/yusei36/KeePassPasskey">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey"
																ToolTip.Tip="Open source code on GitHub">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr Contributors}"
																				 Description="github.com/yusei36/KeePassPasskey/graphs/contributors">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey/graphs/contributors"
																ToolTip.Tip="Open contributors on GitHub">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr ReportBug}"
																				 Description="github.com/yusei36/KeePassPasskey/issues">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey/issues"
																ToolTip.Tip="Open issue tracker on GitHub">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr License}"
																				 Description="GNU GPL v3.0 or later"
																				 IsVisible="{Binding HasLicense}">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenLicenseCommand}"
																ToolTip.Tip="Open license text">
														<ui:FASymbolIcon Symbol="Document" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{u:Tr ThirdPartyNotices}"
																				 Description="Open source licenses for bundled libraries"
																				 IsVisible="{Binding HasThirdPartyNotices}">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenThirdPartyNoticesCommand}"
																ToolTip.Tip="Open third-party notices">
														<ui:FASymbolIcon Symbol="Document" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

				</StackPanel>
		</ScrollViewer>

				<!-- Blocks interaction while settings load from KeePass on page entry. -->
				<Border Grid.Row="0" Grid.RowSpan="2"
								IsVisible="{Binding IsLoading}"
								Background="{DynamicResource SmokeFillColorDefaultBrush}">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
								<ui:FAProgressRing IsIndeterminate="True" Width="48" Height="48"
																	 HorizontalAlignment="Center" />
								<TextBlock Text="{u:Tr LoadingSettings}" HorizontalAlignment="Center" />
						</StackPanel>
				</Border>
		</Grid>

</UserControl>
